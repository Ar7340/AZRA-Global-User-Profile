# ── AZRA Global User Profile ─────────────────────────────────────────
# Storage driver: "json" (development store) — "mysql" is reserved for the
# production swap (schema already authored in src/migrations/).
AZRA_DB_DRIVER=json

# Directory for the JSON store (gitignored; created on first run).
AZRA_DATA_DIR=./data

# Debounce window (ms) for flushing JSON tables to disk. 0 = flush immediately.
AZRA_FLUSH_DEBOUNCE_MS=250

# debug | info | warn | error
AZRA_LOG_LEVEL=info

# In-process cache
AZRA_CACHE_TTL_MS=30000
AZRA_CACHE_MAX_KEYS=5000

# Background aggregation worker
AZRA_AGGREGATION_POLL_MS=2000
AZRA_AGGREGATION_BATCH=50
AZRA_AGGREGATION_MAX_ATTEMPTS=5

# Event ingestion retry budget per event id
AZRA_EVENTS_MAX_ATTEMPTS=3

# ── MySQL (reserved for the production swap; see src/migrations/) ────
# AZRA_DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=azra_profiles
# DB_USER=azra
# DB_PASSWORD=change-me
# DB_CONNECTION_LIMIT=20

# ── Discord bot integration ──────────────────────────────────────────
# From the Discord Developer Portal → Your Application → Bot.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands instantly in one dev guild.
DISCORD_GUILD_ID=
# Sharing level applied the FIRST time the bot sees a guild.
# Privacy-first default: NONE — guild admins opt in via /profile-settings.
# NONE | MINIMAL | STANDARD | FULL
AZRA_DEFAULT_SHARING_LEVEL=NONE
# Required in the Developer Portal → Bot → Privileged Gateway Intents:
#   • SERVER MEMBERS INTENT   (member joins/leaves, role changes)
#   • MESSAGE CONTENT INTENT  (message activity tracking)

